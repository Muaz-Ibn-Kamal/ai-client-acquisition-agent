# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/client_acquisition

# LLM provider (kept behind an abstraction layer — do not hard-code
# business logic to one vendor)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# LLM cost governance (configurable limits, not hard-coded caps in code)
LLM_MAX_TOKENS_PER_REQUEST=
LLM_MAX_REQUESTS_PER_RUN=
LLM_REQUEST_TIMEOUT_SECONDS=

# App
LOG_LEVEL=INFO
APP_ENV=development

# Lead discovery source credentials
# Add provider-specific keys here once specific sources are chosen and
# approved (source selection is a major decision — see Permanent Rules ->
# "When requirements are ambiguous")

# Website research (optional overrides)
# FETCH_TIMEOUT_SECONDS=10
# FETCH_MAX_BYTES=1000000

# Google Places discovery provider (optional; provider disabled when unset)
GOOGLE_PLACES_API_KEY=
